# Copy to ops/production.env, chmod 600, replace every placeholder.
RELEASE=replace-with-commit-sha
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=replace-with-random-url-safe-password
DATABASE_URL=postgresql://jobab:replace-with-random-url-safe-password@postgres:5432/jobab
REDIS_URL=redis://redis:6379
NODE_ENV=production
PORT=3000
WEB_ORIGIN=https://app.example.com
PUBLIC_URL=https://api.example.com
META_APP_ID=replace-me
META_APP_SECRET=replace-me
META_VERIFY_TOKEN=replace-me
META_GRAPH_VERSION=v22.0
MESSENGER_DRY_RUN=false
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=replace-me
LLM_MAX_ITERATIONS=5
LLM_MAX_OUTPUT_TOKENS=1024
PROVIDER_TIMEOUT_MS=15000
AI_DAILY_TOKEN_LIMIT=100000
EMAIL_MODE=resend
EMAIL_FROM=Jobab <support@example.com>
RESEND_API_KEY=replace-me
PAYMENT_MODE=cod
BKASH_SANDBOX=true
# Enable bKash only after sandbox acceptance and live credentials are provisioned.
# PAYMENT_MODE=bkash
# BKASH_SANDBOX=false
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# SENTRY_DSN=
# ALERT_WEBHOOK_URL=

# Explicit operator approval for each WooCommerce hostname; HTTPS only.
WOO_ALLOWED_HOSTS=
# Optional Jina key enables real catalog embeddings; run the backfill endpoint after setting it.
JINA_API_KEY=
